// CALENDARIO DE AUSENCIAS - RUTA DIRECTA ESTABLE
// =====================================================
Route::middleware(['auth', 'admin'])
    ->get('/admin/permisos/calendario', function (\Illuminate\Http\Request $request) {
        $anio = (int) $request->input('anio', now()->year);
        $mes = (int) $request->input('mes', now()->month);

        if ($mes < 1 || $mes > 12) {
            $mes = now()->month;
        }

        $fechaBase = \Carbon\Carbon::create($anio, $mes, 1)->locale('es')->startOfMonth();
        $inicioCalendario = $fechaBase->copy()->startOfMonth()->startOfWeek(\Carbon\Carbon::MONDAY);
        $finCalendario = $fechaBase->copy()->endOfMonth()->endOfWeek(\Carbon\Carbon::SUNDAY);
        $diasCalendario = collect(\Carbon\CarbonPeriod::create($inicioCalendario, $finCalendario));

        $areas = \Illuminate\Support\Facades\Schema::hasTable('areas')
            ? \Illuminate\Support\Facades\DB::table('areas')->orderBy('nombre')->get()
            : collect();

        $tipos = \Illuminate\Support\Facades\Schema::hasTable('tipos_permisos')
            ? \Illuminate\Support\Facades\DB::table('tipos_permisos')->orderBy('nombre')->get()
            : collect();

        $solicitudesPorDia = collect();

        if (\Illuminate\Support\Facades\Schema::hasTable('permisos_solicitudes')) {
            $query = \Illuminate\Support\Facades\DB::table('permisos_solicitudes as s')
                ->leftJoin('empleados as e', 'e.id', '=', 's.empleado_id')
                ->leftJoin('areas as a', 'a.id', '=', 's.area_id')
                ->leftJoin('tipos_permisos as tp', 'tp.id', '=', 's.tipo_permiso_id')
                ->select(
                    's.*',
                    'e.nombre as empleado_nombre',
                    'e.puesto as empleado_puesto',
                    'a.nombre as area_nombre',
                    'tp.nombre as tipo_permiso_nombre'
                )
                ->whereDate('s.fecha_inicio', '<=', $finCalendario->toDateString())
                ->whereDate('s.fecha_fin', '>=', $inicioCalendario->toDateString());

            if ($request->filled('area_id')) {
                $query->where('s.area_id', $request->input('area_id'));
            }

            if ($request->filled('tipo_permiso_id')) {
                $query->where('s.tipo_permiso_id', $request->input('tipo_permiso_id'));
            }

            if ($request->filled('estatus')) {
                $query->where('s.estatus', $request->input('estatus'));
            }

            $solicitudes = $query->orderBy('s.fecha_inicio')->get();

            foreach ($solicitudes as $solicitud) {
                if (empty($solicitud->fecha_inicio) || empty($solicitud->fecha_fin)) {
                    continue;
                }

                $desde = \Carbon\Carbon::parse($solicitud->fecha_inicio)->startOfDay();
                $hasta = \Carbon\Carbon::parse($solicitud->fecha_fin)->startOfDay();

                if ($desde->lt($inicioCalendario)) {
                    $desde = $inicioCalendario->copy();
                }

                if ($hasta->gt($finCalendario)) {
                    $hasta = $finCalendario->copy();
                }

                foreach (\Carbon\CarbonPeriod::create($desde, $hasta) as $dia) {
                    $key = $dia->format('Y-m-d');

                    if (! $solicitudesPorDia->has($key)) {
                        $solicitudesPorDia[$key] = collect();
                    }

                    $solicitudesPorDia[$key]->push($solicitud);
                }
            }
        }

        $nombresMeses = [
            1 => 'Enero',
            2 => 'Febrero',
            3 => 'Marzo',
            4 => 'Abril',
            5 => 'Mayo',
            6 => 'Junio',
            7 => 'Julio',
            8 => 'Agosto',
            9 => 'Septiembre',
            10 => 'Octubre',
            11 => 'Noviembre',
            12 => 'Diciembre',
        ];

        $diasSemana = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];

        $estatusOptions = [
            'formato_enviado' => 'Formato enviado',
            'formato_pendiente' => 'Formato pendiente',
            'formato_recibido' => 'Formato recibido',
            'con_observaciones' => 'Con observaciones',
            'cancelado' => 'Cancelado',
        ];

        return view('admin.permisos.calendario', compact(
            'anio',
            'mes',
            'fechaBase',
            'inicioCalendario',
            'finCalendario',
            'diasCalendario',
            'solicitudesPorDia',
            'nombresMeses',
            'diasSemana',
            'areas',
            'tipos',
            'estatusOptions'
        ));
    })
    ->name('admin.permisos.calendario');

